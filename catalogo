  <style>
    /* 1. RESET Y TOKENS DE DISEÑO (GASTRONOMÍA WCAG AA) */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      --primary: #b45309;
      --primary-dark: #92400e;
      --accent: #ea580c;
      --accent-hover: #c2410c;
      --bg: #fefce8;
      --surface: #ffffff;
      --surface-alt: #fef3c7;
      --text: #1c1917;
      --text-muted: #57534e;
      --border: #fde68a;
      --whatsapp: #15803d;
      --whatsapp-hover: #166534;

      /* Escala Tipográfica y Espaciado Fluido */
      --font-h1: clamp(1.85rem, 1.8vw + 1.4rem, 3.15rem);
      --font-h2: clamp(1.4rem, 1.2vw + 1.1rem, 2.2rem);
      --font-h3: clamp(1.15rem, 0.5vw + 1rem, 1.35rem);
      --font-body: clamp(1rem, 0.25vw + 0.95rem, 1.125rem);
      --space-section: clamp(2.5rem, 4.5vw + 1.25rem, 5rem);
      --gutter: clamp(1rem, 2vw + 0.5rem, 1.75rem);

      /* Elevaciones y Transiciones */
      --shadow-sm: 0 1px 3px rgba(28, 25, 23, 0.08);
      --shadow-md: 0 4px 12px rgba(180, 83, 9, 0.1);
      --shadow-lg: 0 12px 24px -4px rgba(28, 25, 23, 0.15);
      --radius: 0.85rem;
      --transition: 200ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    html {
      scroll-behavior: smooth;
    }

    body {
      font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      font-size: var(--font-body);
      line-height: 1.6;
      color: var(--text);
      background-color: var(--bg);
      -webkit-font-smoothing: antialiased;
    }

    /* 2. ESTRUCTURA Y CONTENEDORES */
    .container {
      width: min(100% - (var(--gutter) * 2), 1200px);
      margin-inline: auto;
    }

    /* 3. HEADER STICKY & NAVEGACIÓN */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 900;
      background-color: rgba(255, 255, 255, 0.95);
      backdrop-filter: blur(8px);
      border-bottom: 1px solid var(--border);
      padding-block: 0.75rem;
    }

    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
    }

    .brand {
      display: flex;
      align-items: center;
      gap: 0.65rem;
      text-decoration: none;
      color: var(--text);
      font-weight: 800;
      font-size: 1.25rem;
      letter-spacing: -0.02em;
    }

    .brand-icon {
      width: 40px;
      height: 40px;
      border-radius: 0.6rem;
      background: linear-gradient(135deg, var(--primary), var(--accent));
      display: grid;
      place-items: center;
      color: #ffffff;
      flex-shrink: 0;
    }

    /* 4. BOTONES ACCESIBLES (>= 44x44px) */
    .btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.5rem;
      min-height: 46px;
      min-width: 46px;
      padding: 0.65rem 1.25rem;
      border-radius: 0.6rem;
      font-weight: 700;
      font-size: 0.95rem;
      text-decoration: none;
      cursor: pointer;
      border: 2px solid transparent;
      transition: transform var(--transition), background-color var(--transition), box-shadow var(--transition);
    }

    .btn:focus-visible, input:focus-visible {
      outline: 3px solid var(--accent);
      outline-offset: 2px;
    }

    .btn-primary {
      background-color: var(--primary);
      color: #ffffff;
    }

    .btn-primary:hover {
      background-color: var(--primary-dark);
      transform: translateY(-1px);
    }

    .btn-accent {
      background-color: var(--accent);
      color: #ffffff;
      box-shadow: var(--shadow-md);
    }

    .btn-accent:hover {
      background-color: var(--accent-hover);
      transform: translateY(-1px);
    }

    .btn-whatsapp {
      background-color: var(--whatsapp);
      color: #ffffff;
      width: 100%;
      font-size: 1.05rem;
    }

    .btn-whatsapp:hover {
      background-color: var(--whatsapp-hover);
    }

    .cart-trigger {
      position: relative;
      background-color: var(--surface-alt);
      color: var(--primary-dark);
      border-color: var(--border);
    }

    .cart-trigger:hover {
      background-color: #fde68a;
    }

    .cart-badge {
      background-color: var(--accent);
      color: #ffffff;
      font-size: 0.8rem;
      font-weight: 800;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      min-width: 24px;
      text-align: center;
    }

    /* 5. HERO SECTION (LCP OPTIMIZADO) */
    .hero {
      padding-block: clamp(2rem, 4vw + 1rem, 4rem);
      background: radial-gradient(circle at top right, #fef3c7 0%, var(--bg) 65%);
      border-bottom: 1px solid var(--border);
    }

    .hero-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
      align-items: center;
      gap: var(--gutter);
    }

    .hero-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      background-color: var(--surface-alt);
      color: var(--primary-dark);
      font-weight: 700;
      font-size: 0.875rem;
      padding: 0.35rem 0.85rem;
      border-radius: 999px;
      margin-bottom: 1rem;
      border: 1px solid var(--border);
    }

    .hero h1 {
      font-size: var(--font-h1);
      line-height: 1.15;
      margin-bottom: 1rem;
      color: var(--text);
    }

    .hero h1 span {
      color: var(--primary);
    }

    .hero p {
      color: var(--text-muted);
      margin-bottom: 1.75rem;
      max-width: 54ch;
    }

    .hero-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .hero-visual {
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      padding: 1.5rem;
      box-shadow: var(--shadow-md);
      display: grid;
      place-items: center;
      aspect-ratio: 16 / 10;
    }

    /* 6. CONTROLES DE CATÁLOGO (BUSCADOR Y FILTROS) */
    .catalog-section {
      padding-block: var(--space-section);
    }

    .section-header {
      margin-bottom: 2rem;
    }

    .section-header h2 {
      font-size: var(--font-h2);
      margin-bottom: 0.35rem;
    }

    .section-header p {
      color: var(--text-muted);
    }

    .toolbar {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2rem;
      background: var(--surface);
      padding: 1.25rem;
      border-radius: var(--radius);
      border: 1px solid var(--border);
      box-shadow: var(--shadow-sm);
    }

    .search-box {
      position: relative;
      width: 100%;
    }

    .search-box svg {
      position: absolute;
      inset-inline-start: 1rem;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-muted);
      pointer-events: none;
    }

    .search-input {
      width: 100%;
      min-height: 48px;
      padding-inline: 2.85rem 1rem;
      border: 2px solid var(--border);
      border-radius: 0.6rem;
      font-size: 1rem;
      font-family: inherit;
      background-color: var(--bg);
      color: var(--text);
      transition: border-color var(--transition);
    }

    .search-input:focus {
      border-color: var(--primary);
      background-color: var(--surface);
    }

    .filter-pills {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .filter-btn {
      min-height: 44px;
      padding: 0.5rem 1rem;
      border-radius: 999px;
      border: 1px solid var(--border);
      background-color: var(--bg);
      color: var(--text);
      font-weight: 600;
      font-size: 0.9rem;
      cursor: pointer;
      transition: all var(--transition);
    }

    .filter-btn:hover {
      border-color: var(--primary);
    }

    .filter-btn[aria-pressed="true"] {
      background-color: var(--primary);
      color: #ffffff;
      border-color: var(--primary);
    }

    /* 7. GRILLA Y TARJETAS CON CONTAINER QUERIES */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(min(100%, 290px), 1fr));
      gap: var(--gutter);
    }

    .card-container {
      container-type: inline-size;
      container-name: dish-card;
    }

    .product-card {
      height: 100%;
      background: var(--surface);
      border: 1px solid var(--border);
      border-radius: var(--radius);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      box-shadow: var(--shadow-sm);
      transition: transform var(--transition), box-shadow var(--transition);
    }

    .product-card:hover {
      transform: translateY(-4px);
      box-shadow: var(--shadow-lg);
    }

    .product-art {
      aspect-ratio: 16 / 9;
      background: linear-gradient(135deg, #fef3c7, #fde68a);
      display: grid;
      place-items: center;
      position: relative;
      padding: 1rem;
    }

    .category-tag {
      position: absolute;
      top: 0.75rem;
      inset-inline-start: 0.75rem;
      background: rgba(255, 255, 255, 0.92);
      color: var(--primary-dark);
      font-size: 0.75rem;
      font-weight: 700;
      padding: 0.25rem 0.65rem;
      border-radius: 999px;
      border: 1px solid var(--border);
    }

    .product-body {
      padding: 1.25rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      justify-content: space-between;
      gap: 1rem;
    }

    .product-title {
      font-size: var(--font-h3);
      font-weight: 700;
      margin-bottom: 0.4rem;
    }

    .product-desc {
      color: var(--text-muted);
      font-size: 0.95rem;
    }

    .product-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding-top: 0.75rem;
      border-top: 1px solid var(--border);
    }

    .quote-badge {
      font-size: 0.85rem;
      font-weight: 700;
      color: var(--primary-dark);
      background: var(--surface-alt);
      padding: 0.3rem 0.65rem;
      border-radius: 0.4rem;
    }

    @container dish-card (min-width: 460px) {
      .product-card {
        flex-direction: row;
      }
      .product-art {
        width: 40%;
        aspect-ratio: auto;
      }
    }

    .empty-state {
      text-align: center;
      padding: 3rem 1rem;
      background: var(--surface);
      border-radius: var(--radius);
      border: 1px dashed var(--primary);
      color: var(--text-muted);
    }

    /* 8. CARRITO DESLIZABLE (SLIDE-OVER DRAWER) */
    .cart-backdrop {
      position: fixed;
      inset: 0;
      background: rgba(28, 25, 23, 0.55);
      z-index: 998;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--transition);
    }

    .cart-backdrop.active {
      opacity: 1;
      pointer-events: auto;
    }

    .cart-drawer {
      position: fixed;
      inset-block: 0;
      inset-inline-end: 0;
      width: min(100%, 440px);
      background: var(--surface);
      z-index: 999;
      display: flex;
      flex-direction: column;
      box-shadow: -8px 0 30px rgba(0, 0, 0, 0.2);
      transform: translateX(100%);
      transition: transform 260ms cubic-bezier(0.4, 0, 0.2, 1);
    }

    .cart-drawer.active {
      transform: translateX(0);
    }

    .drawer-header {
      padding: 1.25rem;
      border-bottom: 1px solid var(--border);
      display: flex;
      align-items: center;
      justify-content: space-between;
      background: var(--bg);
    }

    .drawer-body {
      padding: 1.25rem;
      overflow-y: auto;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .cart-item {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0.75rem;
      padding: 0.85rem;
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 0.65rem;
    }

    .cart-item-info {
      flex-grow: 1;
    }

    .cart-item-title {
      font-weight: 700;
      font-size: 0.98rem;
    }

    .cart-item-cat {
      font-size: 0.8rem;
      color: var(--text-muted);
    }

    .qty-controls {
      display: flex;
      align-items: center;
      gap: 0.35rem;
    }

    .qty-btn {
      min-width: 44px;
      min-height: 44px;
      border-radius: 0.5rem;
      border: 1px solid var(--border);
      background: var(--surface);
      color: var(--text);
      font-weight: 800;
      font-size: 1.1rem;
      cursor: pointer;
    }

    .qty-btn:hover {
      background: var(--surface-alt);
    }

    .qty-value {
      min-width: 28px;
      text-align: center;
      font-weight: 700;
    }

    .drawer-footer {
      padding: 1.25rem;
      border-top: 1px solid var(--border);
      background: var(--bg);
      display: flex;
      flex-direction: column;
      gap: 0.85rem;
    }

    .customer-note {
      width: 100%;
      min-height: 46px;
      padding: 0.65rem 0.85rem;
      border: 1px solid var(--border);
      border-radius: 0.5rem;
      font-family: inherit;
      font-size: 0.95rem;
    }

    /* 9. FOOTER */
    .site-footer {
      background: var(--text);
      color: #f5f5f4;
      padding-block: 2.5rem;
      margin-top: 2rem;
    }

    .footer-inner {
      display: flex;
      flex-wrap: wrap;
      justify-content: space-between;
      align-items: center;
      gap: 1.5rem;
    }

    .footer-meta {
      font-size: 0.9rem;
      color: #d6d3d1;
    }
  </style>
</head>
