    <div class="container footer-inner">
      <div>
        <strong style="font-size: 1.15rem; color: #ffffff;">La Mesa Boliviana</strong>
        <p class="footer-meta">Gastronomía Típica Boliviana • Santa Cruz de la Sierra, Bolivia</p>
      </div>
      <div class="footer-meta">
        <span>Pedidos directos: +591 62016619</span>
      </div>
    </div>
  </footer>

  <script>
    /* ARQUITECTURA JAVASCRIPT VANILLA SEGURA (PREVENCIÓN ESTRICTA DOM-XSS) */
    document.addEventListener('DOMContentLoaded', () => {
      const WHATSAPP_NUMBER = '59162016619';
      const STORAGE_KEY = 'la_mesa_boliviana_cart_v1';

      const MENU_ITEMS = [
        {
          id: 'majadito-charque',
          name: 'Majadito de Charque o Pato',
          category: 'Oriente',
          description: 'Arroz tradicional tostado con urucú, charque desmenuzado, huevo frito, plátano maduro frito y yuca.'
        },
        {
          id: 'locro-carretero',
          name: 'Locro Carretero Cruceño',
          category: 'Oriente',
          description: 'Sopa espesa tradicional del oriente con arroz, charque de res, plátano verde y hierbas aromáticas.'
        },
        {
          id: 'keperi-beniano',
          name: 'Keperí al Horno',
          category: 'Oriente',
          description: 'Corte tierno marinado con limón y especias, horneado lentamente y acompañado de arroz con queso y ensalada.'
        },
        {
          id: 'silpancho',
          name: 'Silpancho Cochabambino',
          category: 'Valles',
          description: 'Carne apanada finamente sobre cama de arroz blanco, papas doradas, dos huevos fritos y pico de gallo.'
        },
        {
          id: 'pique-macho',
          name: 'Pique Macho Tradicional',
          category: 'Valles',
          description: 'Trozos jugosos de carne de res, salchicha, papas fritas, locoto, cebolla, tomate y huevo duro.'
        },
        {
          id: 'chicharron-cerdo',
          name: 'Chicharrón de Cerdo',
          category: 'Valles',
          description: 'Costillas y trozos de cerdo dorados en su punto, servidos con mote blanco, chuño y llajua fresca.'
        },
        {
          id: 'plato-paceno',
          name: 'Plato Paceño',
          category: 'Altiplano',
          description: 'Combinación andina de choclo tierno, habas cocidas, papa con cáscara, queso criollo frito y llajua.'
        },
        {
          id: 'fricase-paceno',
          name: 'Fricasé Paceño',
          category: 'Altiplano',
          description: 'Caldo sustancioso de ají amarillo con carne de cerdo tierna, chuño negro y mote de maíz.'
        },
        {
          id: 'saltenas',
          name: 'Salteñas Tradicionales (Pollo / Carne)',
          category: 'Horneados',
          description: 'Empanada horneada jugosa con relleno ligeramente dulce y picante, aceituna, huevo y papa.'
        },
        {
          id: 'cunape-sonso',
          name: 'Combo Cuñapé y Sonso de Yuca',
          category: 'Horneados',
          description: 'Panecillos de almidón de yuca con abundante queso criollo y masa asada de yuca con queso.'
        }
      ];

      let activeCategory = 'Todos';
      let searchQuery = '';
      let cart = loadCart();

      const productsGrid = document.getElementById('productsGrid');
      const searchInput = document.getElementById('searchInput');
      const categoryFilters = document.getElementById('categoryFilters');
      const cartCountEl = document.getElementById('cartCount');
      const cartDrawer = document.getElementById('cartDrawer');
      const cartBackdrop = document.getElementById('cartBackdrop');
      const openCartBtn = document.getElementById('openCartBtn');
      const closeCartBtn = document.getElementById('closeCartBtn');
      const cartItemsContainer = document.getElementById('cartItemsContainer');
      const sendWhatsappBtn = document.getElementById('sendWhatsappBtn');
      const orderNoteInput = document.getElementById('orderNote');

      function loadCart() {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          return saved ? JSON.parse(saved) : {};
        } catch (e) {
          return {};
        }
      }

      function saveCart() {
        try {
          localStorage.setItem(STORAGE_KEY, JSON.stringify(cart));
        } catch (e) {
          // Ignorar si el almacenamiento está restringido
        }
      }

      function createDishSvg() {
        const svgNS = 'http://www.w3.org/2000/svg';
        const svg = document.createElementNS(svgNS, 'svg');
        svg.setAttribute('width', '72');
        svg.setAttribute('height', '72');
        svg.setAttribute('viewBox', '0 0 64 64');
        svg.setAttribute('fill', 'none');
        svg.setAttribute('aria-hidden', 'true');

        const plate = document.createElementNS(svgNS, 'circle');
        plate.setAttribute('cx', '32');
        plate.setAttribute('cy', '34');
        plate.setAttribute('r', '22');
        plate.setAttribute('fill', '#ffffff');
        plate.setAttribute('stroke', '#b45309');
        plate.setAttribute('stroke-width', '3');

        const food = document.createElementNS(svgNS, 'circle');
        food.setAttribute('cx', '32');
        food.setAttribute('cy', '34');
        food.setAttribute('r', '13');
        food.setAttribute('fill', '#ea580c');

        const garnish = document.createElementNS(svgNS, 'circle');
        garnish.setAttribute('cx', '36');
        garnish.setAttribute('cy', '30');
        garnish.setAttribute('r', '4');
        garnish.setAttribute('fill', '#fde047');

        svg.appendChild(plate);
        svg.appendChild(food);
        svg.appendChild(garnish);
        return svg;
      }

      function renderCatalog() {
        productsGrid.replaceChildren();

        const filtered = MENU_ITEMS.filter(item => {
          const matchesCat = activeCategory === 'Todos' || item.category === activeCategory;
          const matchesSearch = item.name.toLowerCase().includes(searchQuery) ||
                                item.description.toLowerCase().includes(searchQuery);
          return matchesCat && matchesSearch;
        });

        if (filtered.length === 0) {
          const emptyDiv = document.createElement('div');
          emptyDiv.className = 'empty-state';
          emptyDiv.style.gridColumn = '1 / -1';
          const msg = document.createElement('p');
          msg.textContent = 'No encontramos platos con ese criterio. Prueba con otro término o selecciona "Todos".';
          emptyDiv.appendChild(msg);
          productsGrid.appendChild(emptyDiv);
          return;
        }

        filtered.forEach(item => {
          const container = document.createElement('article');
          container.className = 'card-container';

          const card = document.createElement('div');
          card.className = 'product-card';

          const art = document.createElement('div');
          art.className = 'product-art';

          const catTag = document.createElement('span');
          catTag.className = 'category-tag';
          catTag.textContent = item.category;

          art.appendChild(catTag);
          art.appendChild(createDishSvg());

          const body = document.createElement('div');
          body.className = 'product-body';

          const textWrap = document.createElement('div');
          const title = document.createElement('h3');
          title.className = 'product-title';
          title.textContent = item.name;

          const desc = document.createElement('p');
          desc.className = 'product-desc';
          desc.textContent = item.description;

          textWrap.appendChild(title);
          textWrap.appendChild(desc);

          const footer = document.createElement('div');
          footer.className = 'product-footer';

          const badge = document.createElement('span');
          badge.className = 'quote-badge';
          badge.textContent = 'Cotizar / Pedir';

          const addBtn = document.createElement('button');
          addBtn.type = 'button';
          addBtn.className = 'btn btn-primary';
          addBtn.dataset.addId = item.id;
          addBtn.textContent = cart[item.id] ? `Añadido (${cart[item.id]})` : '+ Agregar';

          footer.appendChild(badge);
          footer.appendChild(addBtn);

          body.appendChild(textWrap);
          body.appendChild(footer);

          card.appendChild(art);
          card.appendChild(body);
          container.appendChild(card);
          productsGrid.appendChild(container);
        });
      }

      function renderCart() {
        cartItemsContainer.replaceChildren();
        const entries = Object.entries(cart).filter(([, qty]) => qty > 0);
        const totalUnits = entries.reduce((acc, [, qty]) => acc + qty, 0);
        cartCountEl.textContent = String(totalUnits);

        if (entries.length === 0) {
          const empty = document.createElement('p');
          empty.style.color = 'var(--text-muted)';
          empty.style.textAlign = 'center';
          empty.style.marginTop = '2rem';
          empty.textContent = 'Tu lista está vacía. Agrega platos típicos del catálogo para armar tu pedido o cotización.';
          cartItemsContainer.appendChild(empty);
          return;
        }

        entries.forEach(([id, qty]) => {
          const item = MENU_ITEMS.find(p => p.id === id);
          if (!item) return;

          const row = document.createElement('div');
          row.className = 'cart-item';

          const info = document.createElement('div');
          info.className = 'cart-item-info';

          const title = document.createElement('div');
          title.className = 'cart-item-title';
          title.textContent = item.name;

          const cat = document.createElement('div');
          cat.className = 'cart-item-cat';
          cat.textContent = `Categoría: ${item.category}`;

          info.appendChild(title);
          info.appendChild(cat);

          const controls = document.createElement('div');
          controls.className = 'qty-controls';

          const decBtn = document.createElement('button');
          decBtn.type = 'button';
          decBtn.className = 'qty-btn';
          decBtn.dataset.decId = id;
          decBtn.setAttribute('aria-label', `Disminuir cantidad de ${item.name}`);
          decBtn.textContent = '−';

          const val = document.createElement('span');
          val.className = 'qty-value';
          val.textContent = String(qty);

          const incBtn = document.createElement('button');
          incBtn.type = 'button';
          incBtn.className = 'qty-btn';
          incBtn.dataset.incId = id;
          incBtn.setAttribute('aria-label', `Aumentar cantidad de ${item.name}`);
          incBtn.textContent = '+';

          controls.appendChild(decBtn);
          controls.appendChild(val);
          controls.appendChild(incBtn);

          row.appendChild(info);
          row.appendChild(controls);
          cartItemsContainer.appendChild(row);
        });
      }

      function updateQuantity(id, delta) {
        const current = cart[id] || 0;
        const next = current + delta;
        if (next <= 0) {
          delete cart[id];
        } else {
          cart[id] = next;
        }
        saveCart();
        renderCart();
        renderCatalog();
      }

      function toggleDrawer(open) {
        cartDrawer.classList.toggle('active', open);
        cartBackdrop.classList.toggle('active', open);
        if (open) {
          closeCartBtn.focus();
        } else {
          openCartBtn.focus();
        }
      }

      /* DELEGACIÓN DE EVENTOS */
      productsGrid.addEventListener('click', (e) => {
        const btn = e.target.closest('[data-add-id]');
        if (!btn) return;
        updateQuantity(btn.dataset.addId, 1);
      });

      cartItemsContainer.addEventListener('click', (e) => {
        const inc = e.target.closest('[data-inc-id]');
        if (inc) {
          updateQuantity(inc.dataset.incId, 1);
          return;
        }
        const dec = e.target.closest('[data-dec-id]');
        if (dec) {
          updateQuantity(dec.dataset.decId, -1);
        }
      });

      categoryFilters.addEventListener('click', (e) => {
        const btn = e.target.closest('.filter-btn');
        if (!btn) return;
        activeCategory = btn.dataset.category;
        categoryFilters.querySelectorAll('.filter-btn').forEach(b => {
          b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
        });
        renderCatalog();
      });

      searchInput.addEventListener('input', (e) => {
        searchQuery = e.target.value.trim().toLowerCase();
        renderCatalog();
      });

      openCartBtn.addEventListener('click', () => toggleDrawer(true));
      closeCartBtn.addEventListener('click', () => toggleDrawer(false));
      cartBackdrop.addEventListener('click', () => toggleDrawer(false));

      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && cartDrawer.classList.contains('active')) {
          toggleDrawer(false);
        }
      });

      sendWhatsappBtn.addEventListener('click', () => {
        const entries = Object.entries(cart).filter(([, qty]) => qty > 0);
        if (entries.length === 0) {
          alert('Por favor, agrega al menos un plato típico a tu lista antes de enviar.');
          return;
        }

        const lines = [
          'Hola *La Mesa Boliviana*, deseo solicitar cotización / pedido de los siguientes platos:',
          ''
        ];

        entries.forEach(([id, qty]) => {
          const item = MENU_ITEMS.find(p => p.id === id);
          if (item) {
            lines.push(`• ${qty}x ${item.name}`);
          }
        });

        const note = orderNoteInput.value.trim();
        if (note) {
          lines.push('');
          lines.push(`*Indicaciones / Zona (Santa Cruz):* ${note}`);
        }

        lines.push('');
        lines.push('Quedo atento a la disponibilidad y total. ¡Gracias!');

        const message = encodeURIComponent(lines.join('\n'));
        const url = `https://wa.me/${WHATSAPP_NUMBER}?text=${message}`;
        window.open(url, '_blank', 'noopener,noreferrer');
      });

      renderCatalog();
      renderCart();
    });
  </script>
</body>
</html>
