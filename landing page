  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // 1. Menú móvil accesible
      const menuToggle = document.getElementById('menuToggle');
      const primaryNav = document.getElementById('primaryNav');

      if (menuToggle && primaryNav) {
        menuToggle.addEventListener('click', () => {
          const isExpanded = menuToggle.getAttribute('aria-expanded') === 'true';
          menuToggle.setAttribute('aria-expanded', String(!isExpanded));
          primaryNav.classList.toggle('open');
        });

        primaryNav.addEventListener('click', (event) => {
          if (event.target.tagName === 'A' && primaryNav.classList.contains('open')) {
            primaryNav.classList.remove('open');
            menuToggle.setAttribute('aria-expanded', 'false');
          }
        });
      }

      // 2. Filtrado interactivo del portafolio de platos típicos (Delegación de eventos)
      const filterBar = document.querySelector('.filter-bar');
      const dishCards = document.querySelectorAll('.dish-card-wrapper');

      if (filterBar) {
        filterBar.addEventListener('click', (event) => {
          const button = event.target.closest('.filter-btn');
          if (!button) return;

          const selectedCategory = button.dataset.filter;

          filterBar.querySelectorAll('.filter-btn').forEach((btn) => {
            btn.classList.remove('active');
          });
          button.classList.add('active');

          dishCards.forEach((card) => {
            const cardCategory = card.dataset.category;
            if (selectedCategory === 'todos' || cardCategory === selectedCategory) {
              card.hidden = false;
            } else {
              card.hidden = true;
            }
          });
        });
      }
    });
  </script>
